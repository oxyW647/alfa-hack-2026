# ── Сеть ──────────────────────────────────────────────────────────────────────
HTTP_PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit-demo-password
POSTGRES_DB=credit_cabinet
POSTGRES_PORT=5432

# ── Backend ───────────────────────────────────────────────────────────────────
APP_NAME=CreditCabinet
DATABASE_URL=postgresql+asyncpg://credit:credit-demo-password@db:5432/credit_cabinet
GUNICORN_WORKERS=2

JWT_SECRET=demo-secret-change-me-demo-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720

MOCK_DOCS_DIR=/app/mock_docs

# ── Демо-аккаунты: создаются при старте backend, под ними фронтенд входит сам ──
DEMO_CLIENT_EMAIL=client@credit-demo.ru
DEMO_CLIENT_PASSWORD=client-demo-pass
DEMO_EMPLOYEE_EMAIL=employee@credit-demo.ru
DEMO_EMPLOYEE_PASSWORD=employee-demo-pass
