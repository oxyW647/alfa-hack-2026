@baseUrl = http://localhost:8080
@clientToken = paste-token-here
@employeeToken = paste-token-here
@applicationId = 1

### Вход клиента
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"email": "client@credit-demo.ru", "password": "client-demo-pass"}

### Вход сотрудника
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{"email": "employee@credit-demo.ru", "password": "employee-demo-pass"}

### Демо-сценарии
GET {{baseUrl}}/api/v1/demo/scenarios
Authorization: Bearer {{clientToken}}

### Создать заявку
POST {{baseUrl}}/api/v1/applications
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "company": {"inn": "781045678123", "name": "ИП Уют Кофе", "legal_form": "IP"},
  "loan": {"amount_rub": 1200000, "term_months": 24, "purpose": "Расширение кофейни"},
  "declared": {
    "age_months": 48,
    "financials": {
      "revenues_last_6_months_rub": [850000, 1200000, 1100000, 980000, 1100000, 770000],
      "average_monthly_operating_expenses_rub": 780000,
      "existing_monthly_debt_payments_rub": 50000,
      "outstanding_debt_before_new_loan_rub": 300000,
      "equity_rub": 4000000,
      "current_assets_rub": 1100000,
      "current_liabilities_rub": 1000000
    },
    "credit_history": "no_overdues_12m"
  }
}

### Запустить конвейер целиком
POST {{baseUrl}}/api/v1/applications/{{applicationId}}/run
Authorization: Bearer {{clientToken}}

### Запустить один этап
POST {{baseUrl}}/api/v1/applications/{{applicationId}}/stages/preliminary_scoring/run
Authorization: Bearer {{employeeToken}}

### Состояние конвейера
GET {{baseUrl}}/api/v1/applications/{{applicationId}}/pipeline
Authorization: Bearer {{employeeToken}}

### Заявка глазами сотрудника
GET {{baseUrl}}/api/v1/applications/{{applicationId}}
Authorization: Bearer {{employeeToken}}

### Ручное решение
POST {{baseUrl}}/api/v1/applications/{{applicationId}}/manual-review
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{"decision": "approve", "comment": "Одобрено вручную"}

### Принять предложение
POST {{baseUrl}}/api/v1/applications/{{applicationId}}/offer/accept
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{"kind": "requested"}
