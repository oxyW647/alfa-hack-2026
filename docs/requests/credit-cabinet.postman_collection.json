              "mode": "raw",
              "raw": "{\n  \"company\": {\n    \"inn\": \"7701234561\",\n    \"name\": \"ООО СтройМаг\",\n    \"legal_form\": \"OOO\"\n  },\n  \"loan\": {\n    \"amount_rub\": 1000000,\n    \"term_months\": 12,\n    \"purpose\": \"Закупка оборудования\"\n  },\n  \"declared\": {\n    \"age_months\": 60,\n    \"financials\": {\n      \"revenues_last_6_months_rub\": [\n        1100000,\n        1200000,\n        1100000,\n        980000,\n        1100000,\n        1000000\n      ],\n      \"average_monthly_operating_expenses_rub\": 600000,\n      \"equity_rub\": 5000000,\n      \"current_assets_rub\": 2100000,\n      \"current_liabilities_rub\": 800000,\n      \"outstanding_debt_before_new_loan_rub\": 300000,\n      \"existing_monthly_debt_payments_rub\": 50000\n    },\n    \"credit_history\": \"no_overdues_12m\"\n  }\n}"
